{
  "name": "olodo",
  "version": "1.0.0",
  "scripts": {
    "start-frontend": "cd web && npm start",
    "start-backend": "cd backend && npm start",

    "start": "concurrently -k -p \"[{name}]\" -n \"BACKEND,WEB\" -c \"yellow,blue\" \"npm run start-backend\" \"npm run start-frontend\" "
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}